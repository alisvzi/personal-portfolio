# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Database — required. PostgreSQL (Neon, Supabase, or any Postgres 13+).
# Local: postgresql://postgres:postgres@localhost:5432/portfolio
#
# Deploying to Vercel? The Neon integration injects DATABASE_URL automatically,
# so this only needs to be set by hand for local development. After deploying,
# check `GET /api` — it reports whether the database is reachable.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Creates the tables. Safe to re-run: every statement is `if not exists`.
# Run once against a fresh database: npm run db:init

# Admin session signing secret — required, at least 32 characters.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Public origin the site is served from — used for canonical URLs, Open Graph,
# sitemap.xml and robots.txt. On Vercel this can be omitted: the platform sets
# VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. The Search Console verification token. When set, the
# `<meta name="google-site-verification">` tag is emitted on every page.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# When empty, no analytics script is loaded and no network request is made.
NEXT_PUBLIC_GA_ID=

# Image storage — optional.
# Without a token, uploads fall back to `public/uploads` for local development.
# On Vercel (read-only filesystem) a Blob token is required for uploads to work.
BLOB_READ_WRITE_TOKEN=

# Admin account seeding — used once by `npm run seed:admin`.
# Remove these from the environment after the account exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
